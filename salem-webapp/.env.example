# Salem web client configuration.
# Copy to `.env` and adjust. `.env` is gitignored.

# WebSocket endpoint of the Salem server.
# Local: ws://localhost:6060   Production: wss://your-host
VITE_SALEM_HOST=ws://localhost:6060

# Sent to the server as AppName / AppVersion.
VITE_SALEM_APP_NAME=Salem
VITE_SALEM_APP_VERSION=0.1.0

# Sent as X-Tinode-APIKey. Must match the API_KEY_SALT configured on the
# server. The default below is the well-known development value that matches
# the salt baked into docker/tinode/Dockerfile.
#
# This is a development credential. Generate a real one before deploying:
#   head -c32 /dev/urandom | base64
VITE_SALEM_API_KEY=AQEAAAABAAD_rAp4DJh05a1HAwFT3A6K

# Persist the message cache in IndexedDB.
VITE_SALEM_PERSIST=true